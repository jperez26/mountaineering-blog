---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="relative overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-summit-slate/5 px-6 py-6 text-center card-hover">
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-summit-ice via-summit-navy to-summit-ember"></div>
  <p class="font-display text-3xl sm:text-4xl font-bold text-summit-navy">{value}</p>
  <p class="mt-1.5 text-xs sm:text-sm font-semibold uppercase tracking-wide text-summit-slate/60">{label}</p>
</div>
