---
interface Props {
  image?: string;
  images?: string[];
  title: string;
  subtitle?: string;
  size?: 'lg' | 'md';
  eyebrow?: string;
}
const { image, images, title, subtitle, size = 'lg', eyebrow } = Astro.props;
const withBase = (src: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + src;
const heightClass = size === 'lg' ? 'h-[75vh] min-h-[480px]' : 'h-[42vh] min-h-[300px]';

const gallery = images && images.length > 0 ? images : image ? [image] : [];
---

<section class={`relative ${heightClass} w-full overflow-hidden bg-summit-forest`}>
  <div class="hero-photo-stack absolute inset-0 h-full w-full">
    {gallery.map((src, i) => (
      i === 0 ? (
        <img
          src={withBase(src)}
          alt=""
          class="hero-bg absolute inset-0 h-full w-full object-cover object-[50%_32%] opacity-100 transition-opacity duration-[1500ms]"
          loading="eager"
        />
      ) : (
        <img
          data-src={withBase(src)}
          alt=""
          class="hero-bg absolute inset-0 h-full w-full object-cover object-[50%_32%] opacity-0 transition-opacity duration-[1500ms]"
        />
      )
    ))}
  </div>
  <!-- Flat tint everywhere, so text stays legible no matter how bright the
       photo is, plus a directional gradient for extra depth at the edges. -->
  <div class="absolute inset-0 bg-summit-forest/35"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-summit-forest/95 via-summit-forest/45 to-summit-forest/25"></div>

  <div class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center text-summit-snow">
    {eyebrow && (
      <p class="mb-3 text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-summit-moss">{eyebrow}</p>
    )}
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold drop-shadow-lg max-w-3xl [text-shadow:0_2px_20px_rgba(0,0,0,0.5)]">
      {title}
    </h1>
    {subtitle && <p class="mt-4 max-w-xl text-lg text-summit-mist/90 [text-shadow:0_1px_8px_rgba(0,0,0,0.4)]">{subtitle}</p>}
    <slot />
  </div>
</section>

<script>
  function preload(img: HTMLImageElement) {
    const pending = img.getAttribute('data-src');
    if (pending && !img.getAttribute('src')) {
      img.src = pending;
    }
  }

  function restartKenBurns(img: HTMLImageElement) {
    img.classList.remove('hero-bg');
    // force reflow so re-adding the class restarts the CSS animation
    void img.offsetWidth;
    img.classList.add('hero-bg');
  }

  function initHeroRotation() {
    document.querySelectorAll('.hero-photo-stack').forEach((stack) => {
      if ((stack as HTMLElement).dataset.bound) return;
      (stack as HTMLElement).dataset.bound = 'true';

      const imgs = Array.from(stack.querySelectorAll('img')) as HTMLImageElement[];
      if (imgs.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let current = 0;
      preload(imgs[1]);

      setInterval(() => {
        const next = (current + 1) % imgs.length;
        preload(imgs[next]);
        preload(imgs[(next + 1) % imgs.length]);

        imgs[current].classList.replace('opacity-100', 'opacity-0');
        imgs[next].classList.replace('opacity-0', 'opacity-100');
        restartKenBurns(imgs[next]);
        current = next;
      }, 7000);
    });
  }

  initHeroRotation();
</script>
