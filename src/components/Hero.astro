---
interface Props {
  image: string;
  title: string;
  subtitle?: string;
  size?: 'lg' | 'md';
}
const { image, title, subtitle, size = 'lg' } = Astro.props;
const withBase = (src: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + src;
const heightClass = size === 'lg' ? 'h-[70vh] min-h-[420px]' : 'h-[38vh] min-h-[260px]';
---

<section class={`relative ${heightClass} w-full overflow-hidden bg-summit-navy`}>
  <img
    src={withBase(image)}
    alt=""
    class="hero-bg absolute inset-0 h-full w-full object-cover opacity-80"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-summit-navy via-summit-navy/40 to-summit-navy/10"></div>
  <div class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center text-summit-snow">
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold drop-shadow-lg max-w-3xl">
      {title}
    </h1>
    {subtitle && <p class="mt-4 max-w-xl text-lg text-summit-glacier/90">{subtitle}</p>}
    <slot />
  </div>
</section>
