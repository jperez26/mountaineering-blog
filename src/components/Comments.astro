---
// Comments via giscus (https://giscus.app) — backed by GitHub Discussions
// on this repo, so no separate service/account to run. Free, no ads, and
// comment data lives in the repo's Discussions tab rather than a third
// party's database.
---

<div class="mt-12 border-t border-summit-fern/15 dark:border-white/10 pt-10">
  <script
    src="https://giscus.app/client.js"
    data-repo="jperez26/mountaineering-blog"
    data-repo-id="R_kgDOTnaEfQ"
    data-category="Announcements"
    data-category-id="DIC_kwDOTnaEfc4DDHkj"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="dark_dimmed"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</div>
