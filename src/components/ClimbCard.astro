---
import type { CollectionEntry } from 'astro:content';

interface Props {
  climb: CollectionEntry<'climbs'>;
}
const { climb } = Astro.props;
const { data, id } = climb;
const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;
const basePath = data.status === 'completed' ? '/summits' : '/planned';
const image = data.heroImage || '/images/placeholders/sunrise.svg';
---

<a href={withBase(`${basePath}/${id}`)} class="group block overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-summit-fern/5 card-hover">
  <div class="relative h-52 overflow-hidden">
    <img src={withBase(image)} alt={data.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/25"></div>
    <span
      class:list={[
        'absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide shadow-sm',
        data.status === 'completed' ? 'bg-summit-moss text-summit-forest' : 'bg-summit-ember text-summit-forest',
      ]}
    >
      {data.status === 'completed' ? 'Summited' : 'Planned'}
    </span>
    <p class="absolute bottom-3 left-4 right-4 font-display text-xl font-bold text-white drop-shadow-md">{data.mountain}</p>
  </div>
  <div class="p-5">
    <p class="text-sm text-summit-fern/70">{data.region} · {data.elevationFt.toLocaleString()} ft</p>
    <p class="mt-3 text-sm text-summit-fern/90 line-clamp-2">{data.summary}</p>
    <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-summit-ember-dark">
      {data.date ? data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : 'Long-Term Goal'}
    </p>
  </div>
</a>
