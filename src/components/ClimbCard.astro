---
import type { CollectionEntry } from 'astro:content';

interface Props {
  climb: CollectionEntry<'climbs'>;
}
const { climb } = Astro.props;
const { data, id } = climb;
const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;
const basePath = data.status === 'completed' ? '/summits' : '/planned';
const image = data.heroImage || '/images/placeholders/sunrise.svg';
---

<a href={withBase(`${basePath}/${id}`)} class="group block overflow-hidden rounded-xl bg-white shadow-md card-hover">
  <div class="relative h-48 overflow-hidden">
    <img src={withBase(image)} alt={data.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
    <span
      class:list={[
        'absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide',
        data.status === 'completed' ? 'bg-summit-ice text-summit-navy' : 'bg-summit-ember text-summit-navy',
      ]}
    >
      {data.status === 'completed' ? 'Summited' : 'Planned'}
    </span>
  </div>
  <div class="p-5">
    <h3 class="font-display text-xl font-bold text-summit-navy">{data.mountain}</h3>
    <p class="mt-1 text-sm text-summit-slate/70">{data.region} · {data.elevationFt.toLocaleString()} ft</p>
    <p class="mt-3 text-sm text-summit-slate/90 line-clamp-2">{data.summary}</p>
    <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-summit-ember-dark">
      {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
    </p>
  </div>
</a>
