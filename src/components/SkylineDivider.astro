---
// A thin skyline of all 14 eight-thousanders, sitting right at the seam
// between a Hero photo and the page content below — meant to soften the
// hard cut from photo into the topo-textured background.
//
// Shapes are stylized approximations of each peak's known real silhouette
// character (K2's famous steep symmetric pyramid, Broad Peak's flat wide
// plateau, Kangchenjunga's multi-summit massif, etc.) — not surveyed
// topographic traces. There's no elevation/terrain data source wired up
// here to trace exact profiles from.
const PEAKS = [
  { name: 'Everest', m: 8849, shape: 'stepped' },
  { name: 'K2', m: 8611, shape: 'sharp' },
  { name: 'Kangchenjunga', m: 8586, shape: 'multi' },
  { name: 'Lhotse', m: 8516, shape: 'stepped', mirror: true },
  { name: 'Makalu', m: 8485, shape: 'sharp' },
  { name: 'Cho Oyu', m: 8188, shape: 'broad' },
  { name: 'Dhaulagiri', m: 8167, shape: 'sharp' },
  { name: 'Manaslu', m: 8163, shape: 'stepped' },
  { name: 'Nanga Parbat', m: 8126, shape: 'broad', mirror: true },
  { name: 'Annapurna', m: 8091, shape: 'multi' },
  { name: 'Gasherbrum I', m: 8080, shape: 'sharp' },
  { name: 'Broad Peak', m: 8051, shape: 'broad' },
  { name: 'Gasherbrum II', m: 8035, shape: 'stepped', mirror: true },
  { name: 'Shishapangma', m: 8027, shape: 'broad' },
];

const width = 1600;
const height = 120;
const groundY = 88; // valley/baseline the peaks sit on
const labelY = groundY + 15;
const peakTopY = 16; // apex y for the tallest peak (Everest)

const minM = Math.min(...PEAKS.map((p) => p.m));
const maxM = Math.max(...PEAKS.map((p) => p.m));
const apexYFor = (m) => {
  const t = (m - minM) / (maxM - minM || 1); // 0..1, 1 = tallest
  return groundY - t * (groundY - peakTopY);
};

const slot = width / PEAKS.length;

// Per-shape point recipes, in slot-local fractions of [-0.5, 0.5] * slotWidth,
// paired with a fraction of (groundY - apexY) added back on top of apexY
// (0 = full peak height, 1 = down at the ground line).
const SHAPES = {
  // A single clean point — K2, Makalu, Gasherbrum I: steep, symmetric pyramids.
  sharp: [{ dx: 0, h: 0 }],
  // A lower false-summit/shoulder before the true summit — Everest's West
  // Shoulder, Lhotse's long ridge, Manaslu and Gasherbrum II's sub-peaks.
  stepped: [
    { dx: -0.26, h: 0.4 },
    { dx: 0.12, h: 0 },
  ],
  // A wide, flat-ish summit plateau — Broad Peak (true to its name), Cho
  // Oyu and Shishapangma's gentler rounded tops, Nanga Parbat's huge mass.
  broad: [
    { dx: -0.22, h: 0.1 },
    { dx: 0.22, h: 0.02 },
  ],
  // A long multi-summit ridge — Kangchenjunga's five summits, Annapurna's
  // massif of I-IV.
  multi: [
    { dx: -0.36, h: 0.35 },
    { dx: -0.13, h: 0.1 },
    { dx: 0.13, h: 0 },
    { dx: 0.36, h: 0.3 },
  ],
};

const peaks = PEAKS.map((p, i) => {
  const slotStart = i * slot;
  const apexX = slotStart + slot / 2;
  const apexY = apexYFor(p.m);
  // Mirroring flips dx *and* reverses point order, so x stays left-to-right
  // (flipping dx alone would make the path double back on itself).
  const baseRecipe = SHAPES[p.shape];
  const recipe = p.mirror
    ? [...baseRecipe].reverse().map((pt) => ({ ...pt, dx: -pt.dx }))
    : baseRecipe;
  const points = recipe.map((pt) => ({
    x: apexX + pt.dx * slot,
    y: apexY + pt.h * (groundY - apexY),
  }));
  // small deterministic jitter so saddles between peaks aren't perfectly uniform
  const jitter = Math.sin(i * 2.4) * 5;
  const saddleY = groundY - Math.max(0, 4 + jitter);
  return { ...p, apexX, points, saddleY };
});

// Build one continuous filled silhouette across all 14 peaks.
let d = `M0,${height} L0,${groundY}`;
peaks.forEach((p, i) => {
  p.points.forEach((pt) => {
    d += ` L${pt.x.toFixed(1)},${pt.y.toFixed(1)}`;
  });
  const isLast = i === peaks.length - 1;
  const nextSaddleX = isLast ? width : (i + 1) * slot;
  const saddleY = isLast ? groundY : p.saddleY;
  d += ` L${nextSaddleX.toFixed(1)},${saddleY.toFixed(1)}`;
});
d += ` L${width},${height} Z`;
---

<div class="skyline-divider relative w-full overflow-hidden leading-none" aria-hidden="true">
  <svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" class="block w-full h-16 sm:h-24">
    <defs>
      <linearGradient id="skyline-fade" x1="0" y1="0" x2="0" y2="1">
        <stop class="skyline-fade-top" offset="0%" stop-color="#182e21" />
        <stop class="skyline-fade-bottom" offset="100%" stop-color="#f8f6f0" />
      </linearGradient>
    </defs>
    <rect x="0" y="0" width={width} height={height} fill="url(#skyline-fade)" />
    <path class="skyline-silhouette" d={d} />
    {peaks.map((p) => (
      <text class="skyline-label" x={p.apexX} y={labelY} text-anchor="middle" font-size="7.5" font-weight="600" letter-spacing="0.02em">
        {p.name}
      </text>
    ))}
  </svg>
</div>
