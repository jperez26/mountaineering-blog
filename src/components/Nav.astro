---
import NavIcon from './NavIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteTitle: string;
}
const { siteTitle } = Astro.props;

const links = [
  { href: '/', label: 'Home', icon: 'home' as const },
  { href: '/blog', label: 'Blog', icon: 'blog' as const },
  { href: '/summits', label: 'Summits', icon: 'axe' as const },
  { href: '/planned', label: 'Planned Trips', icon: 'screw' as const },
  { href: '/timeline', label: 'Timeline', icon: 'timeline' as const },
  { href: '/map', label: 'Map', icon: 'map' as const },
];

const gearLinks = [
  { href: '/gear', label: 'Gear Reviews' },
  { href: '/gear/guide', label: 'Buying Guide' },
];

const path = new URL(Astro.request.url).pathname;
const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;
---

<header class="sticky top-0 z-50 bg-summit-forest/90 backdrop-blur-md text-summit-snow shadow-lg border-b border-white/5">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between">
      <a href={withBase('/')} class="-ml-4 sm:-ml-6 font-display text-xl font-bold tracking-wide shrink-0">
        {siteTitle}
      </a>

      <nav class="hidden lg:flex items-center gap-5 text-sm font-semibold">
        {links.map((link) => (
          <a
            href={withBase(link.href)}
            class:list={[
              'nav-link flex items-center gap-1.5 whitespace-nowrap transition-colors hover:text-summit-moss',
              path === link.href || (link.href !== '/' && path.startsWith(link.href)) ? 'active text-summit-moss' : 'text-summit-snow',
            ]}
          >
            <NavIcon name={link.icon} />
            {link.label}
          </a>
        ))}

        <div class="relative group">
          <button
            type="button"
            class:list={[
              'nav-link flex items-center gap-1.5 whitespace-nowrap border-0 bg-transparent p-0 font-semibold transition-colors hover:text-summit-moss',
              path.startsWith('/gear') ? 'active text-summit-moss' : 'text-summit-snow',
            ]}
          >
            <NavIcon name="carabiner" />
            Gear
            <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5l4.5 5 4.5-5z" /></svg>
          </button>
          <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block pt-3 min-w-[11rem]">
            <div class="rounded-lg bg-summit-fern shadow-2xl overflow-hidden border border-white/10">
              {gearLinks.map((link) => (
                <a href={withBase(link.href)} class="block px-4 py-2.5 text-sm whitespace-nowrap hover:bg-summit-forest hover:text-summit-moss transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a
          href={withBase('/gallery')}
          class:list={[
            'nav-link flex items-center gap-1.5 whitespace-nowrap transition-colors hover:text-summit-moss',
            path.startsWith('/gallery') ? 'active text-summit-moss' : 'text-summit-snow',
          ]}
        >
          <NavIcon name="camera" />
          Gallery
        </a>
        <a
          href={withBase('/contact')}
          class="flex items-center gap-1.5 whitespace-nowrap rounded-full bg-summit-ember px-5 py-2 text-summit-forest hover:bg-orange-400 hover:shadow-lg hover:shadow-orange-500/30 transition-all"
        >
          <NavIcon name="knot" class="h-[18px] w-[18px] text-summit-forest" />
          Contact
        </a>
        <ThemeToggle class="text-summit-snow" />
      </nav>

      <div class="flex items-center gap-1 lg:hidden">
        <ThemeToggle class="text-summit-snow" />
        <button id="menu-toggle" class="p-2" aria-label="Toggle menu" aria-expanded="false">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="lg:hidden max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out flex flex-col gap-1 text-sm font-semibold">
      <div class="flex flex-col gap-1 pb-4 pt-1">
        {[
          ...links,
          { href: '/gear', label: 'Gear Reviews', icon: 'carabiner' as const },
          { href: '/gear/guide', label: 'Buying Guide', icon: 'carabiner' as const },
          { href: '/gallery', label: 'Gallery', icon: 'camera' as const },
          { href: '/contact', label: 'Contact', icon: 'knot' as const },
        ].map((link) => (
          <a href={withBase(link.href)} class="flex items-center gap-2 py-2 border-b border-white/5 last:border-0 hover:text-summit-moss">
            <NavIcon name={link.icon} />
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('max-h-0');
    menu?.classList.toggle('max-h-0', !isOpen);
    menu?.classList.toggle('max-h-[28rem]', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
