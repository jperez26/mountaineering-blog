---
// Small line-art icons themed around climbing gear, used in the main nav.
// All strokes use currentColor so they inherit the link's hover/active color;
// the small accent dots (flag, waypoint) stay a fixed ember tone on purpose.
interface Props {
  name: 'home' | 'blog' | 'axe' | 'screw' | 'timeline' | 'map' | 'carabiner' | 'camera' | 'knot' | 'search';
  class?: string;
}
const { name, class: className = 'h-[18px] w-[18px]' } = Astro.props;
---

{name === 'home' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 18 L8.5 8 L11.5 12.5 L15 6 L21 18" />
    <line x1="15" y1="6" x2="15" y2="2" />
    <path d="M15 2 L19.5 3.6 L15 5.2 Z" fill="#c8702f" stroke="none" />
  </svg>
)}

{name === 'blog' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 6 C9.5 4 5.5 4 3.5 5 V18.5 C5.5 17.5 9.5 17.5 12 19.5 C14.5 17.5 18.5 17.5 20.5 18.5 V5 C18.5 4 14.5 4 12 6 Z" />
    <line x1="12" y1="6" x2="12" y2="19.5" />
  </svg>
)}

{name === 'axe' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <line x1="7" y1="20" x2="17" y2="4" />
    <path d="M17 4 q-3 -1 -4.5 2" />
    <line x1="14.5" y1="5" x2="19.5" y2="7" />
  </svg>
)}

{name === 'screw' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="4" r="1.8" />
    <line x1="12" y1="5.8" x2="12" y2="8" />
    <path d="M8.5 8 H15.5 V16 a3.5 3.5 0 0 1 -7 0 Z" />
    <line x1="8.7" y1="10" x2="15.3" y2="8.6" />
    <line x1="8.5" y1="12.8" x2="15.3" y2="11.4" />
    <line x1="8.9" y1="15.6" x2="14.9" y2="14.4" />
  </svg>
)}

{name === 'timeline' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3.5 18 C7 18 7 8 12 8 C17 8 17 18 20.5 18" />
    <circle cx="3.5" cy="18" r="1.4" fill="currentColor" stroke="none" />
    <circle cx="12" cy="8" r="1.4" fill="#c8702f" stroke="none" />
    <circle cx="20.5" cy="18" r="1.4" fill="currentColor" stroke="none" />
  </svg>
)}

{name === 'map' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 5 L14.3 12 L12 19 L9.7 12 Z" fill="currentColor" stroke="none" />
    <circle cx="12" cy="12" r="1.3" fill="white" stroke="currentColor" stroke-width="1" />
  </svg>
)}

{name === 'carabiner' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 4 C6 4 4.5 6.5 4.5 10 C4.5 15 6.5 19 9.5 20.5 C11 21.2 12.5 20.8 12.5 19 V6 C12.5 4.5 11 4 9 4 Z" />
    <line x1="12.5" y1="10.5" x2="17" y2="10.5" />
  </svg>
)}

{name === 'camera' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 6 L10 4 H14 L15 6 H19.5 V18.5 H4.5 V6 Z" />
    <circle cx="12" cy="12" r="3.8" />
  </svg>
)}

{name === 'search' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="10.5" cy="10.5" r="6.5" />
    <line x1="15.3" y1="15.3" x2="20.5" y2="20.5" />
  </svg>
)}

{name === 'knot' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 12 C4 8 8 8 9.5 11 C11 14 13 14 14.5 11 C16 8 20 8 20 12 C20 16 16 16 14.5 13 C13 10 11 10 9.5 13 C8 16 4 16 4 12 Z" />
  </svg>
)}
