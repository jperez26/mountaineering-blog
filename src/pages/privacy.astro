---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const lastUpdated = 'July 2026';
const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;
---

<BaseLayout title="Privacy Policy" description="What data this site collects, and what it doesn't.">
  <Hero image="/images/climbs/washington.jpg" eyebrow="Legal" title="Privacy Policy" subtitle="Short version: there's barely any data collection here, and here's exactly what there is." size="md" />

  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-20 reveal">
    <p class="text-sm text-summit-fern/70 dark:text-summit-mist/80 mb-8">Last updated: {lastUpdated}</p>

    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-display prose-a:text-summit-ember-dark dark:prose-a:text-summit-ember">
      <p>
        This is a personal, non-commercial mountaineering blog. It doesn't run ads, doesn't sell data, and doesn't use
        tracking analytics. Here's the complete list of the places data moves when you use this site:
      </p>

      <h2>Contact form</h2>
      <p>
        The <a href={withBase('/contact')}>Contact</a> page sends whatever you type (name, email, message) to
        <a href="https://formspree.io" target="_blank" rel="noopener">Formspree</a>, a third-party form backend, which
        forwards it to the site owner's email. Formspree's own
        <a href="https://formspree.io/legal/privacy-policy" target="_blank" rel="noopener">privacy policy</a> governs how
        they handle that submission. Nothing you type is stored anywhere else, and it's never used for anything other
        than replying to you.
      </p>

      <h2>Map page</h2>
      <p>
        The <a href={withBase('/map')}>Map</a> page loads map tiles directly from
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>. Like any
        website request, that request exposes your IP address to OpenStreetMap's servers. This site has no control
        over and receives none of that data.
      </p>

      <h2>Weather widget</h2>
      <p>
        Summit and planned-trip pages show live conditions by calling
        <a href="https://open-meteo.com" target="_blank" rel="noopener">Open-Meteo</a>'s free weather API directly from
        your browser. Same deal as the map: your browser talks to their server directly, exposing your IP to them, and
        this site never sees or stores that request.
      </p>

      <h2>Theme preference</h2>
      <p>
        The light/dark toggle saves your choice in your browser's <code>localStorage</code> under a single key
        (<code>theme</code>). It never leaves your device, isn't a cookie, and isn't used to identify or track you —
        it just remembers which theme you last picked.
      </p>

      <h2>Hosting</h2>
      <p>
        This site is hosted on <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a>,
        which — like virtually any web host — logs standard server access data (IP address, requested page, timestamp)
        for operating the service. See GitHub's
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener">
          general privacy statement
        </a> for details.
      </p>

      <h2>No cookies, no analytics, no ads</h2>
      <p>
        This site does not set its own cookies, does not run any analytics script (Google Analytics, Plausible, or
        otherwise), and does not serve ads. If that ever changes, this page will be updated to say so.
      </p>

      <h2>Questions</h2>
      <p>Reach out via the <a href={withBase('/contact')}>Contact</a> page with anything about this policy.</p>
    </div>
  </section>
</BaseLayout>
