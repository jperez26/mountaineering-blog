---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const gear = await getCollection('gear', ({ data }) => !data.draft);
  return gear.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);
const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;
const image = data.image || '/images/placeholders/gear-neutral.svg';
---

<BaseLayout title={data.item} description={`${data.brand ? data.brand + ' ' : ''}${data.item} review`}>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 pt-28 pb-20 reveal">
    <a href={withBase('/gear')} class="text-sm font-semibold text-summit-ember-dark hover:underline">← Back to Gear Reviews</a>

    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <div class="overflow-hidden rounded-2xl bg-summit-mist h-64 sm:h-full flex items-center justify-center">
        <img src={withBase(image)} alt={data.item} class="h-full w-full object-contain p-8" />
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-summit-ember-dark">{data.category}</p>
        <h1 class="font-display text-3xl font-bold text-summit-forest mt-1">{data.item}</h1>
        {data.brand && <p class="text-summit-fern/70">{data.brand}</p>}
        <div class="mt-3 flex items-center gap-1" aria-label={`${data.rating} out of 5 stars`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <svg class:list={['h-5 w-5', i < data.rating ? 'text-summit-ember' : 'text-summit-fern/20']} viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 1l2.9 6 6.6.6-5 4.5 1.5 6.5-6-3.6-6 3.6 1.5-6.5-5-4.5 6.6-.6z" />
            </svg>
          ))}
        </div>
        {data.priceRange && <p class="mt-3 font-semibold text-summit-forest">{data.priceRange}</p>}

        <div class="mt-6 grid grid-cols-2 gap-4">
          <div>
            <p class="text-sm font-semibold text-green-700">Pros</p>
            <ul class="mt-1 space-y-1 text-sm text-summit-fern/90 list-disc list-inside">
              {data.pros.map((pro) => <li>{pro}</li>)}
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-red-700">Cons</p>
            <ul class="mt-1 space-y-1 text-sm text-summit-fern/90 list-disc list-inside">
              {data.cons.map((con) => <li>{con}</li>)}
            </ul>
          </div>
        </div>

        {data.elevationTags.length > 0 && (
          <div class="mt-4 flex gap-2 flex-wrap">
            {data.elevationTags.map((tag) => (
              <span class="rounded-full bg-summit-mist px-3 py-1 text-xs font-semibold text-summit-forest">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="prose prose-slate mt-10 max-w-none prose-headings:font-display prose-a:text-summit-ember-dark">
      <Content />
    </div>
  </section>
</BaseLayout>
