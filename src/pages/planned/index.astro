---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ClimbCard from '../../components/ClimbCard.astro';
import { getCollection } from 'astro:content';

const climbs = (await getCollection('climbs', ({ data }) => !data.draft && data.status === 'planned')).sort(
  (a, b) => (a.data.date?.valueOf() ?? Infinity) - (b.data.date?.valueOf() ?? Infinity)
);
---

<BaseLayout title="Planned Trips" description="What's next on the list.">
  <Hero image="/images/climbs/orizaba.jpg" eyebrow="What's Next" title="Planned Trips" subtitle="The peaks I'm training and planning for next." size="md" />

  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-20 reveal">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {climbs.map((climb) => <ClimbCard climb={climb} />)}
    </div>
    {climbs.length === 0 && <p class="text-summit-fern/70 dark:text-summit-mist/80">Nothing planned yet — add one in <code>src/content/climbs/</code> with <code>status: planned</code>.</p>}
  </section>
</BaseLayout>
