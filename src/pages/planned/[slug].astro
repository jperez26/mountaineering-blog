---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ClimbMap from '../../components/ClimbMap.astro';
import ElevationProfile from '../../components/ElevationProfile.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const climbs = await getCollection('climbs', ({ data }) => !data.draft && data.status === 'planned');
  return climbs.map((climb) => ({
    params: { slug: climb.id },
    props: { climb },
  }));
}

const { climb } = Astro.props;
const { data, id } = climb;
const { Content } = await render(climb);
const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;

const facts = [
  { label: 'Elevation', value: `${data.elevationFt.toLocaleString()} ft${data.elevationM ? ` (${data.elevationM.toLocaleString()} m)` : ''}` },
  ...(data.elevationGainFt ? [{ label: 'Elevation Gain', value: `${data.elevationGainFt.toLocaleString()} ft` }] : []),
  { label: 'Region', value: data.region },
  { label: 'Target Date', value: data.date ? data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : 'Long-term goal' },
  ...(data.difficulty ? [{ label: 'Difficulty', value: data.difficulty }] : []),
  ...(data.route ? [{ label: 'Planned Route', value: data.route }] : []),
];
---

<BaseLayout title={data.title} description={data.summary}>
  <Hero image={data.heroImage || '/images/placeholders/forest.svg'} eyebrow="Planned" title={data.mountain} subtitle={data.title} />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-20 reveal">
    <div class="grid gap-4 sm:grid-cols-3 mb-10">
      {facts.map((f) => (
        <div class="rounded-xl bg-white shadow-sm ring-1 ring-summit-fern/10 px-4 py-3">
          <p class="text-xs uppercase tracking-wide text-summit-fern/60">{f.label}</p>
          <p class="font-semibold text-summit-forest">{f.value}</p>
        </div>
      ))}
    </div>

    {data.coordinates && (
      <div class="mb-10">
        <WeatherWidget lat={data.coordinates[0]} lng={data.coordinates[1]} mountain={data.mountain} />
      </div>
    )}

    <p class="text-lg text-summit-fern/90 italic border-l-4 border-summit-moss pl-4">{data.summary}</p>

    <div class="prose prose-slate mt-8 max-w-none prose-headings:font-display prose-a:text-summit-ember-dark">
      <Content />
    </div>

    {data.profile && data.profile.length > 1 && (
      <div class="mt-10">
        <ElevationProfile profile={data.profile} gainFt={data.elevationGainFt} />
      </div>
    )}

    {data.coordinates && (
      <div class="mt-10">
        <h2 class="font-display text-2xl font-bold text-summit-forest mb-4">Location</h2>
        <ClimbMap
          height="320px"
          points={[{ lat: data.coordinates[0], lng: data.coordinates[1], title: data.mountain, href: `/planned/${id}`, status: data.status }]}
        />
      </div>
    )}

    <a href={withBase('/planned')} class="mt-10 inline-block text-sm font-semibold text-summit-ember-dark hover:underline">← Back to Planned Trips</a>
  </section>
</BaseLayout>
