---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SkylineDivider from '../../components/SkylineDivider.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;

const hasTripInfo = Boolean(data.howToGetThere || data.whatToBring?.length || data.costBreakdown?.length);
const totalCost = data.costBreakdown?.reduce((sum, c) => {
  const n = parseFloat(String(c.cost).replace(/[^0-9.]/g, ''));
  return Number.isFinite(n) ? sum + n : sum;
}, 0);

const postUrl = new URL(withBase(`/blog/${post.id}`), Astro.site);
const postImageUrl = new URL(withBase(data.heroImage || '/images/placeholders/snow.svg'), Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.excerpt,
  datePublished: data.date.toISOString(),
  image: String(postImageUrl),
  mainEntityOfPage: String(postUrl),
  author: { '@type': 'Person', name: 'Joe' },
};
---

<BaseLayout title={post.data.title} description={post.data.excerpt} image={data.heroImage} jsonLd={jsonLd}>
  <Hero image={post.data.heroImage || '/images/placeholders/snow.svg'} eyebrow="Field Notes" title={post.data.title} size="md" />
  <SkylineDivider />

  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-20 reveal">
    <p class="text-sm font-semibold uppercase tracking-wide text-summit-ember-dark dark:text-summit-ember">
      {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    <div class="mt-2 flex gap-2 flex-wrap">
      {data.tags.map((tag) => (
        <span class="rounded-full bg-summit-mist px-3 py-1 text-xs font-semibold text-summit-forest">{tag}</span>
      ))}
    </div>

    {hasTripInfo && (
      <div class="mt-8 rounded-2xl bg-summit-mist/60 dark:bg-summit-forest/40 ring-1 ring-summit-fern/10 dark:ring-white/10 p-6 space-y-6">
        <h2 class="font-display text-xl font-bold text-summit-forest dark:text-summit-mist">
          Trip Info{data.mountain ? `: ${data.mountain}` : ''}
        </h2>

        {data.howToGetThere && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-summit-ember-dark dark:text-summit-ember mb-1">Getting There</p>
            <p class="text-summit-fern/90 dark:text-summit-mist/80">{data.howToGetThere}</p>
          </div>
        )}

        {data.whatToBring && data.whatToBring.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-summit-ember-dark dark:text-summit-ember mb-1">What to Bring</p>
            <ul class="grid gap-1 sm:grid-cols-2 text-summit-fern/90 dark:text-summit-mist/80 list-disc list-inside">
              {data.whatToBring.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        {data.costBreakdown && data.costBreakdown.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-summit-ember-dark dark:text-summit-ember mb-1">Cost Breakdown</p>
            <ul class="divide-y divide-summit-fern/10 dark:divide-white/15">
              {data.costBreakdown.map((c) => (
                <li class="flex items-center justify-between py-1.5 text-summit-fern/90 dark:text-summit-mist/80">
                  <span>{c.item}</span>
                  <span class="font-semibold text-summit-forest dark:text-summit-mist">{c.cost}</span>
                </li>
              ))}
            </ul>
            {totalCost ? (
              <p class="mt-2 flex items-center justify-between font-semibold text-summit-forest dark:text-summit-mist border-t border-summit-fern/20 dark:border-white/15 pt-2">
                <span>Estimated Total</span>
                <span>${totalCost.toLocaleString()}</span>
              </p>
            ) : null}
          </div>
        )}
      </div>
    )}

    <div class="prose prose-slate dark:prose-invert mt-8 max-w-none prose-headings:font-display prose-a:text-summit-ember-dark dark:text-summit-ember">
      <Content />
    </div>
    <a href={withBase('/blog')} class="mt-10 inline-block text-sm font-semibold text-summit-ember-dark dark:text-summit-ember hover:underline">← Back to Blog</a>

    <Comments />
  </article>
</BaseLayout>
