---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const withBase = (href: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + href;
---

<BaseLayout title="Blog" description="Trip reports, training notes, and everything in between.">
  <Hero image="/images/climbs/washington.jpg" eyebrow="Field Notes" title="Blog" subtitle="Trip reports, training notes, and lessons learned along the way." size="md" />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-20 reveal">
    <div class="space-y-8">
      {posts.map((post) => (
        <a href={withBase(`/blog/${post.id}`)} class="group flex flex-col sm:flex-row gap-5 overflow-hidden rounded-2xl bg-white dark:bg-summit-fern shadow-md ring-1 ring-summit-fern/5 dark:ring-white/10 card-hover">
          <div class="sm:w-64 h-48 sm:h-auto flex-shrink-0 overflow-hidden">
            <img
              src={withBase(post.data.heroImage || '/images/placeholders/snow.svg')}
              alt={post.data.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
          </div>
          <div class="p-5 flex flex-col">
            <p class="text-xs font-semibold uppercase tracking-wide text-summit-ember-dark dark:text-summit-ember">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="mt-1 font-display text-2xl font-bold text-summit-forest dark:text-summit-mist">{post.data.title}</h2>
            <p class="mt-2 text-summit-fern/80 dark:text-summit-mist/80">{post.data.excerpt}</p>
            <div class="mt-3 flex gap-2 flex-wrap">
              {post.data.tags.map((tag) => (
                <span class="rounded-full bg-summit-mist px-3 py-1 text-xs font-semibold text-summit-forest">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
      {posts.length === 0 && <p class="text-summit-fern/70 dark:text-summit-mist/80">No posts yet — add one in <code>src/content/blog/</code>.</p>}
    </div>
  </section>
</BaseLayout>
